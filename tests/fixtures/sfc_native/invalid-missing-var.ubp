module main
variables Source After B1 B2 B3 Gate Join Done Choice1 Choice2 Choice3 SourceEntry SourceLoop AfterEntry AfterLoop B1Entry B1Loop B2Entry B2Loop B3Entry B3Loop Completed Heartbeat PeerSeen
script 30 30 {
whenStarted
sfcSequence {
sfcStep 'Source' { SourceEntry += 1 } { SourceLoop += 1 }
sfcTransition 'Gate'
sfcOr 'Absent' {
sfcStep 'B1' { B1Entry += 1
PeerSeen = B2 } { waitMillis 30
B1Loop += 1 }
} 'Choice2' {
sfcStep 'B2' { B2Entry += 1 } { B2Loop += 1 }
} 'Choice3' {
sfcStep 'B3' { B3Entry += 1 } { B3Loop += 1 }
}
sfcOrJoin 'Join'
sfcStep 'After' { AfterEntry += 1 } { AfterLoop += 1 }
sfcTransition 'Done'
}
Completed += 1
}
script 800 30 {
whenStarted
forever { Heartbeat += 1
waitMillis 2 }
}
