+/* Application may isolate decoded pointer fields in a bounded CPU-only pool.
+ * The default retains upstream nanopb behavior. Never publish partial results. */
+__weak int esp_hosted_mcu_decode_rpc(const uint8_t *wire, size_t length, Rpc *rpc)
+{
+	pb_istream_t stream = pb_istream_from_buffer(wire, length);
+	return pb_decode(&stream, Rpc_fields, rpc) ? 0 : -EBADMSG;
+}
