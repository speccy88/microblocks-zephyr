+/* The older compatible control path has no pre-init IfaceMac RPC. */
+static int esp_hosted_mcu_ap_only_init(struct esp_hosted_mcu_data *data)
+{
+ Rpc req = Rpc_init_zero, resp = Rpc_init_zero;
+ req.msg_id = RpcId_Req_WifiInit;
+ req.which_payload = Rpc_req_wifi_init_tag;
+ esp_hosted_mcu_default_init_config(&req.payload.req_wifi_init);
+ /* Host-side approved storage is separate; do not load a foreign C6 NVS config. */
+ req.payload.req_wifi_init.cfg.nvs_enable = 0;
+ /* AP-only control must stay awake while mode/config/start are sequenced. */
+ req.payload.req_wifi_init.cfg.sta_disconnected_pm = 0;
+ int ret = esp_hosted_mcu_rpc_call(&req, &resp, ESP_HOSTED_MCU_RPC_TIMEOUT);
+ pb_release(Rpc_fields, &resp);
+ if (ret) return -EIO;
+ for (size_t i = 0; i < ESP_HOSTED_MCU_IFACE_COUNT; i++) {
+  req = (Rpc)Rpc_init_zero;
+  resp = (Rpc)Rpc_init_zero;
+  req.msg_id = RpcId_Req_GetMACAddress;
+  req.which_payload = Rpc_req_get_mac_address_tag;
+  req.payload.req_get_mac_address.mode = (i == ESP_HOSTED_MCU_IFACE_STA)
+   ? ESP_HOSTED_MCU_WIFI_IF_STA : ESP_HOSTED_MCU_WIFI_IF_AP;
+  ret = esp_hosted_mcu_rpc_call(&req, &resp, ESP_HOSTED_MCU_RPC_TIMEOUT);
+  if (!ret && resp.which_payload == Rpc_resp_get_mac_address_tag &&
+      resp.payload.resp_get_mac_address.resp == 0 &&
+      resp.payload.resp_get_mac_address.mac.size == ESP_HOSTED_MCU_MAC_ADDR_LEN) {
+   memcpy(data->mac_addr[i], resp.payload.resp_get_mac_address.mac.bytes,
+          ESP_HOSTED_MCU_MAC_ADDR_LEN);
+  } else ret = -EIO;
+  pb_release(Rpc_fields, &resp);
+  if (ret) return ret;
+ }
+ return 0; /* No SetMode/Start/Connect until the application configures AP. */
+}
