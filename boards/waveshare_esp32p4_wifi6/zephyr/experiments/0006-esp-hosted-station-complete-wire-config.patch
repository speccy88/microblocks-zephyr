 	sta = &req.payload.req_wifi_set_config.cfg.u.sta;
+ if (IS_ENABLED(CONFIG_WIFI_ESP_HOSTED_MCU_DEFER_STATION)) {
+  /* Match official host submessage presence. Current WPA2 policy stays WPA2. */
+  sta->has_threshold = true;
+  sta->threshold.rssi = -127;
+  sta->threshold.authmode = 3; /* IDF WIFI_AUTH_WPA2_PSK */
+  sta->has_pmf_cfg = true; /* zero: neither required nor advertised */
+  sta->sae_h2e_identifier.funcs.encode = p4_encode_empty_sae_identifier;
