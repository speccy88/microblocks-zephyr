+/* Official host always serializes the fixed SAE-H2E identifier array.
+ * Empty identifier, no authentication value or credential in this callback. */
+static bool p4_encode_empty_sae_identifier(pb_ostream_t *stream,
+ const pb_field_t *field, void * const *arg)
+{
+ static const uint8_t empty[32];
+ ARG_UNUSED(arg);
+ return pb_encode_tag_for_field(stream, field) &&
+        pb_encode_string(stream, empty, sizeof(empty));
+}
+
 static bool p4_station_started;
 
