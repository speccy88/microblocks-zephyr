module 'P4 Camera' Output
author 'ESP32-P4 SmallVM integration; MicroBlocks contributors'
version 0 3
description 'Native Zephyr camera and portable images. Four immutable images, 8 MiB total: release when finished. Sizes are width x height in pixels. Resize uses nearest neighbor. Smooth resize/rotate/flip use P4 PPA on RGB565/RGB888; smooth scale ratios must be multiples of 1/16. Check image processing status for unsupported input or errors. Preview/export stays in this browser. Pi Camera v2.1 / IMX219 manual settings are RAM-only: exposure 4..1156 lines, analogue register 0..232, digital register 256..4095. Reset/reboot restores 800/128/256. Busy/unsupported/invalid changes return false. Snapshot uses current applied settings, returns a 320x180 image and opens preview; release its handle when finished. Sliders also show the exact tuple used. No automatic exposure, white balance or motorized focus.'
spec 'r' 'p4TakePicture' 'take picture'
spec 'r' 'p4TakeSnapshot' 'take snapshot (current camera settings)'
spec 'r' 'p4TakeSnapshotSize' 'take snapshot width _ height _' 'num num' 160 90
spec ' ' '[p4:cameraControls]' 'open snapshot sliders'
spec ' ' '[p4:cameraSettings]' 'camera exposure _ analog gain _ digital gain _' 'num num num' 800 128 256
spec ' ' '[p4:cameraSettingsReset]' 'reset camera settings'
spec 'r' '[p4:cameraSettingsStatus]' 'camera settings'
spec 'r' '[p4:imageWidth]' 'image _ width' 'num' 1
spec 'r' '[p4:imageHeight]' 'image _ height' 'num' 1
spec 'r' '[p4:imageResize]' 'resize image _ to _ x _' 'num num num' 1 160 90
spec 'r' '[p4:imageGrayscale]' 'grayscale image _' 'num' 1
spec 'r' 'p4SmoothResize' 'smooth resize _ to _ x _' 'num num num' 1 160 90
spec 'r' 'p4RotateImage' 'rotate _ left _ deg' 'num num' 1 90
spec 'r' 'p4FlipHorizontal' 'flip image _ left to right' 'num' 1
spec 'r' 'p4FlipVertical' 'flip image _ top to bottom' 'num' 1
spec 'r' '[p4:ppaStatus]' 'image processing status'
spec 'b' '[p4:imagePreview]' 'preview / export image _' 'num' 1
spec 'b' '[p4:imageRelease]' 'release image _' 'num' 1
spec ' ' '[p4:imageReleaseAll]' 'release all images'
spec 'b' '[p4:imageValid]' 'image _ valid?' 'num' 1
spec 'r' '[p4:cameraStatus]' 'camera status'
advanced
spec 'r' '[p4:imageTestPattern]' 'color pattern width _ height _' 'num num' 160 96
spec 'b' '[p4:ppaStart]' 'start PPA image _ width _ height _ angle _ mirror _' 'num num num num num' 1 160 96 0 0
spec 'b' '[p4:ppaBusy]' 'image processing busy?'
spec 'r' '[p4:ppaResult]' 'processed image result'
spec ' ' '[p4:ppaCancel]' 'cancel image processing'
spec 'r' '[p4:imageCreate]' 'blank image width _ height _ format _' 'num num num' 160 90 1
spec 'r' '[p4:dspCapabilities]' 'DSP backends'
spec 'r' '[p4:imageRGBTensor]' 'image _ to RGB888 tensor width _ height _' 'num num num' 1 96 96
spec 'r' '[p4:imageFormat]' 'image _ format' 'num' 1
spec 'r' '[p4:imageBytes]' 'image _ byte count' 'num' 1
spec 'r' '[p4:imageRead]' 'image _ bytes from offset _ count _' 'num num num' 1 0 100
spec 'r' '[p4:imageMemory]' 'image memory used'
spec 'r' '[p4:imageCount]' 'image count'
spec 'b' '[p4:cameraRequest]' 'start camera still'
spec 'b' '[p4:cameraBusy]' 'camera busy?'
spec 'r' '[p4:cameraResult]' 'camera result handle'

to p4TakePicture {
    if (not ('[p4:cameraRequest]')) { return 0 }
    waitUntil (not ('[p4:cameraBusy]'))
    return ('[p4:cameraResult]')
}

to p4TakeSnapshot {
    return (p4TakeSnapshotSize 320 180)
}

to p4TakeSnapshotSize w h {
    if (or (or (w < 16) (w > 1280)) (or (h < 16) (h > 720))) { return 0 }
    local original (p4TakePicture)
    if (original == 0) { return 0 }
    local small ('[p4:imageResize]' original w h)
    '[p4:imageRelease]' original
    if (small > 0) { '[p4:imagePreview]' small }
    return small
}

to p4SmoothResize image w h {
    if (not ('[p4:ppaStart]' image w h 0 0)) { return 0 }
    waitUntil (not ('[p4:ppaBusy]'))
    return ('[p4:ppaResult]')
}

to p4RotateImage image degrees {
    if (not ('[p4:imageValid]' image)) { return 0 }
    if (not ('[p4:ppaStart]' image ('[p4:imageWidth]' image) ('[p4:imageHeight]' image) degrees 0)) { return 0 }
    waitUntil (not ('[p4:ppaBusy]'))
    return ('[p4:ppaResult]')
}

to p4FlipHorizontal image {
    if (not ('[p4:imageValid]' image)) { return 0 }
    if (not ('[p4:ppaStart]' image ('[p4:imageWidth]' image) ('[p4:imageHeight]' image) 0 1)) { return 0 }
    waitUntil (not ('[p4:ppaBusy]'))
    return ('[p4:ppaResult]')
}

to p4FlipVertical image {
    if (not ('[p4:imageValid]' image)) { return 0 }
    if (not ('[p4:ppaStart]' image ('[p4:imageWidth]' image) ('[p4:imageHeight]' image) 0 2)) { return 0 }
    waitUntil (not ('[p4:ppaBusy]'))
    return ('[p4:ppaResult]')
}
