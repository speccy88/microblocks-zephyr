module main
script 100 30 {
    whenStarted
    sayIt (i2cIdentifyDevices 0)
    sendBroadcast 'show name'
}
script 260 180 {
    whenBroadcastReceived 'show name'
    sayIt (i2cDeviceName 1)
    sendBroadcast 'show address'
}
script 260 300 {
    whenBroadcastReceived 'show address'
    sayIt (i2cDeviceBusAddress 1)
    sendBroadcast 'show ID'
}
script 260 420 {
    whenBroadcastReceived 'show ID'
    sayIt (i2cReadMeasurement 'device ID' 1)
}
