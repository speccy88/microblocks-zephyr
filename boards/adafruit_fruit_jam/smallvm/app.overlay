#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/pwm/pwm.h>
#include <zephyr/dt-bindings/gpio/gpio.h>
/ {
	zephyr,user {
		/* Factory AirLift only; manual CS allows its BUSY handshake before clocks. */
		airlift-cs-gpios = <&gpio0_hi 14 GPIO_ACTIVE_LOW>;
		airlift-busy-gpios = <&gpio0 3 GPIO_ACTIVE_HIGH>;
		airlift-reset-gpios = <&gpio0 22 GPIO_ACTIVE_LOW>;
		/* Safe extension D0..D8. High-bank GPIO40..45 use port-relative 8..13. */
		digital-pin-gpios = <&gpio0 6 0>, <&gpio0 7 0>, <&gpio0 10 0>,
			<&gpio0_hi 8 0>, <&gpio0_hi 9 0>, <&gpio0_hi 10 0>,
			<&gpio0_hi 11 0>, <&gpio0_hi 12 0>, <&gpio0_hi 13 0>;
		adc-pin-gpios = <&gpio0_hi 8 0>, <&gpio0_hi 9 0>, <&gpio0_hi 10 0>,
			<&gpio0_hi 11 0>, <&gpio0_hi 12 0>, <&gpio0_hi 13 0>;
		io-channels = <&adc 0>, <&adc 1>, <&adc 2>, <&adc 3>, <&adc 4>, <&adc 5>;
		pwm-pin-gpios = <&gpio0 6 0>, <&gpio0 7 0>, <&gpio0 10 0>,
			<&gpio0_hi 8 0>, <&gpio0_hi 9 0>, <&gpio0_hi 10 0>,
			<&gpio0_hi 11 0>, <&gpio0_hi 12 0>, <&gpio0_hi 13 0>;
		pwms = <&pwm 6 PWM_USEC(1000) PWM_POLARITY_NORMAL>,
			<&pwm 7 PWM_USEC(1000) PWM_POLARITY_NORMAL>,
			<&pwm 10 PWM_USEC(1000) PWM_POLARITY_NORMAL>,
			<&pwm 16 PWM_USEC(1000) PWM_POLARITY_NORMAL>,
			<&pwm 17 PWM_USEC(1000) PWM_POLARITY_NORMAL>,
			<&pwm 18 PWM_USEC(1000) PWM_POLARITY_NORMAL>,
			<&pwm 19 PWM_USEC(1000) PWM_POLARITY_NORMAL>,
			<&pwm 20 PWM_USEC(1000) PWM_POLARITY_NORMAL>,
			<&pwm 21 PWM_USEC(1000) PWM_POLARITY_NORMAL>;
	};
};
&pinctrl {
	airlift_spi1: airlift_spi1 {
		rx { pinmux = <SPI1_RX_P28>; input-enable; input-schmitt-enable; };
		tx-clock { pinmux = <SPI1_SCK_P30>, <SPI1_TX_P31>; };
	};
};
&spi1 {
	pinctrl-0 = <&airlift_spi1>;
	pinctrl-names = "default";
	status = "okay";
};
&zephyr_udc0 {
	mb_cdc: mb_cdc { compatible = "zephyr,cdc-acm-uart"; };
};
&adc {
	#address-cells = <1>;
	#size-cells = <0>;
	channel@0 { reg = <0>; zephyr,gain = "ADC_GAIN_1"; zephyr,reference = "ADC_REF_VDD_1"; zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>; zephyr,resolution = <12>; };
	channel@1 { reg = <1>; zephyr,gain = "ADC_GAIN_1"; zephyr,reference = "ADC_REF_VDD_1"; zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>; zephyr,resolution = <12>; };
	channel@2 { reg = <2>; zephyr,gain = "ADC_GAIN_1"; zephyr,reference = "ADC_REF_VDD_1"; zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>; zephyr,resolution = <12>; };
	channel@3 { reg = <3>; zephyr,gain = "ADC_GAIN_1"; zephyr,reference = "ADC_REF_VDD_1"; zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>; zephyr,resolution = <12>; };
	channel@4 { reg = <4>; zephyr,gain = "ADC_GAIN_1"; zephyr,reference = "ADC_REF_VDD_1"; zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>; zephyr,resolution = <12>; };
	channel@5 { reg = <5>; zephyr,gain = "ADC_GAIN_1"; zephyr,reference = "ADC_REF_VDD_1"; zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>; zephyr,resolution = <12>; };
};
