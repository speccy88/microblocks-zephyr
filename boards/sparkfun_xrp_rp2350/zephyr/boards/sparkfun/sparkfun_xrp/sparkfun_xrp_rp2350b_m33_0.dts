/* SPDX-License-Identifier: Apache-2.0
 * RP2350B composition: Zephyr Metro RP2350, Pete Johanson 2025.
 * RM2 PIO composition adapted from Zephyr RP2350B Plus W:
 * Copyright (c) 2024 Andrew Featherstone
 * Copyright (c) 2026 Matheus de Alencar; MASSDRIVER EI (massdriver.space).
 * Production XRP wiring: SparkFun schematic 86c4cd7f, factual pin mapping. */
/dts-v1/;
#include <raspberrypi/rpi_pico/rp2350b.dtsi>
#include <raspberrypi/rpi_pico/m33.dtsi>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/i2c/i2c.h>
#include "sparkfun_xrp-pinctrl.dtsi"
/ {
    model = "SparkFun XRP Controller RP2350 production";
    compatible = "sparkfun,xrp-rp2350";
    chosen {
        zephyr,sram = &sram0;
        zephyr,flash = &flash0;
        zephyr,flash-controller = &qmi;
        zephyr,code-partition = &code_partition;
    };
    zephyr,user {
        /* Eight DRV8411A inputs, logical order L/R/3/4. All low = coast. */
        motor-input-gpios = <&gpio0_hi 2 GPIO_ACTIVE_HIGH>, <&gpio0_hi 3 GPIO_ACTIVE_HIGH>,
            <&gpio0_hi 0 GPIO_ACTIVE_HIGH>, <&gpio0_hi 1 GPIO_ACTIVE_HIGH>,
            <&gpio0 20 GPIO_ACTIVE_HIGH>, <&gpio0 21 GPIO_ACTIVE_HIGH>,
            <&gpio0 10 GPIO_ACTIVE_HIGH>, <&gpio0 11 GPIO_ACTIVE_HIGH>;
        user-button-gpios = <&gpio0_hi 4 GPIO_ACTIVE_LOW>;
    };
};
&flash0 {
    reg = <0x10000000 DT_SIZE_M(16)>;
    ranges = <0x0 0x10000000 DT_SIZE_M(16)>;
    partitions {
        ranges;
        #address-cells = <1>;
        #size-cells = <1>;
        code_partition: partition@0 {
            compatible = "zephyr,mapped-partition";
            label = "code-partition";
            reg = <0x0 DT_SIZE_M(8)>;
            read-only;
        };
        wifi_settings: partition@f80000 {
            compatible = "zephyr,mapped-partition";
            label = "wifi-settings";
            reg = <0xf80000 0x10000>;
        };
        vmstore: partition@fc0000 {
            compatible = "zephyr,mapped-partition";
            label = "vmstore";
            reg = <0xfc0000 0x40000>;
        };
    };
};
&gpio0 { status = "okay"; };
&gpio0_hi { status = "okay"; };
&i2c0 {
    clock-frequency = <I2C_BITRATE_STANDARD>;
    pinctrl-0 = <&i2c0_default>; pinctrl-names = "default";
    status = "okay";
};
&i2c1 {
    clock-frequency = <I2C_BITRATE_STANDARD>;
    pinctrl-0 = <&i2c1_default>; pinctrl-names = "default";
    status = "okay";
};
&timer0 { status = "okay"; };
&vreg { status = "okay"; };
zephyr_udc0: &usbd { status = "okay"; };
/* PIO0 is reserved for RM2. No motor/servo/RGB pinctrl is enabled at boot.
 * Firmware/CLM blobs retain their separate upstream redistribution terms. */
&pio0 {
    status = "okay";
    xrp_radio_spi: spi {
        compatible = "raspberrypi,pico-spi-pio";
        clocks = <&clocks RPI_PICO_CLKID_CLK_SYS>;
        #address-cells = <1>; #size-cells = <0>;
        cs-gpios = <&gpio0 27 GPIO_ACTIVE_LOW>;
        clk-gpios = <&gpio0 28 GPIO_ACTIVE_HIGH>;
        sio-gpios = <&gpio0 29 GPIO_ACTIVE_HIGH>;
        pinctrl-0 = <&xrp_radio_clock>; pinctrl-names = "default";
        status = "okay";
        xrp_wifi: wifi@0 {
            compatible = "infineon,airoc-wifi";
            reg = <0>;
            wifi-reg-on-gpios = <&gpio0 26 GPIO_ACTIVE_HIGH>;
            bus-select-gpios = <&gpio0 29 GPIO_ACTIVE_HIGH>;
            wifi-host-wake-gpios = <&gpio0 29 GPIO_ACTIVE_HIGH>;
            spi-max-frequency = <10000000>;
            spi-half-duplex;
            spi-data-irq-shared;
            pinctrl-0 = <&xrp_radio_data>;
            pinctrl-1 = <&xrp_radio_irq>;
            pinctrl-names = "default", "host_wake";
            status = "okay";
            xrp_radio_gpio: gpio {
                compatible = "infineon,cyw43-gpio";
                gpio-controller; #gpio-cells = <2>; ngpios = <3>;
            };
        };
    };
};
