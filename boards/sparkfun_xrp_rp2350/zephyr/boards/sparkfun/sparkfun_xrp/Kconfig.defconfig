# Radio defaults follow the pinned Zephyr RP2350B Plus W target.
if BOARD_SPARKFUN_XRP
config USB_SELF_POWERED
    default n
if WIFI_AIROC
choice AIROC_PART
    default CYW43439
endchoice
config WHD_DISABLE_SDIO_PULLUP_DURING_SPI_SLEEP
    default y
endif
endif
