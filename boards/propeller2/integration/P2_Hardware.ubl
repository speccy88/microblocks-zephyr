to p2ConfigureSmartPin pin mode x y {
    '[p2:p2SmartPin]' pin mode x y
}

to p2FrequencyHz pin hz {
    '[p2:p2Frequency]' pin hz
}

to p2StartSmartPinRaw pin mode x y {
    '[p2:p2SmartPinRaw]' pin mode x y
}

to p2Repository value pin {
    return ('[p2:p2Configure]' pin 'repository' 'logic' value 0 false 0)
}

spec 'b' 'p2DACNoise' 'P2 try DAC noise pin _ X hex _ Y hex _ B offset _' 'num str str num' 0 '0' '0' 0
to p2DACNoise pin x y b {
    return ('[p2:p2Configure]' pin 'DAC noise' 'DAC 990R 3V' x y true b)
}

