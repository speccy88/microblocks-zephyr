module 'P2 Hardware' Output
author 'Native FlexC port; MicroBlocks SmallVM contributors'
version 0 10
description 'Native P2 extension 8. USB at 115200. Pins P58-63 are reserved; EC32MB also reserves P40-57. Workers use main-cog services for heap and pin operations. Outputs can drive hardware. Advanced X/Y values are hardware registers; consult the board documentation.'
choices p2PulseResult 'high' 'period'
choices p2DMAInput 'Schmitt' 'logic' 'ADC 1x' 'ADC 3x' 'ADC 10x' 'ADC 30x' 'ADC 100x' 'ADC ground' 'ADC VIO' 'ADC floating'
choices p2FilterLength 2 3 5 8
choices p2FilterField 'length' 'tap' 'users' 'sample clocks hex' 'configuration hex'
choices p2Logic 'pass A' 'A AND B' 'A OR B' 'A XOR B'
choices p2LevelCircuit 'level A' 'level A feedback negative' 'level B feedback positive' 'level B feedback negative'
choices p2SINC 'SINC2' 'SINC3'
choices p2CaptureField 'state' 'available' 'raw' 'emitted' 'cog' 'pin' 'local DIR' 'scale' 'maximum gap clocks' 'elapsed clocks' 'expected clocks' 'wraps' 'scope channels' 'continuous bits' 'DMA' 'sample clocks' 'page words' 'buffer guards' 'pretrigger words' 'record words' 'trigger word' 'history discarded words' 'startup discarded words'
choices p2Event 'high' 'rise' 'edge'
choices p2Edges 'rise to rise' 'rise to edge' 'edge to rise' 'edge to edge'
choices p2ScopeFilter 'Tukey 68' 'Tukey 45' 'Hann 28'
choices p2ADCMode 'sample' 'SINC2 accumulator' 'SINC3 accumulator' 'bitstream'
choices p2PeriodResult 'clock ticks' 'high clocks'
choices p2WindowResult 'clock ticks' 'high clocks' 'periods'
choices p2Mode 'input' 'pull-up' 'pull-down' 'NCO frequency' 'NCO duty' 'PWM sawtooth' 'PWM triangle' 'count rises' 'count highs'
choices p2Pad 'logic' 'logic A feedback' 'logic B feedback' 'Schmitt' 'Schmitt A feedback' 'Schmitt B feedback' 'compare A B' 'compare A B feedback' 'ADC ground' 'ADC VIO' 'ADC floating' 'ADC 1x' 'ADC 3x' 'ADC 10x' 'ADC 30x' 'ADC 100x' 'DAC 990R 3V' 'DAC 600R 2V' 'DAC 124R 3V' 'DAC 75R 2V' 'level A' 'level A feedback negative' 'level B feedback positive' 'level B feedback negative'
choices p2Operation 'repository' 'DAC noise' 'DAC random dither' 'DAC PWM dither' 'pulse' 'transition' 'NCO frequency' 'NCO duty' 'PWM triangle' 'PWM sawtooth' 'PWM SMPS' 'quadrature' 'register up' 'register up down' 'count rises' 'count highs' 'state ticks' 'high ticks' 'event ticks' 'period ticks' 'period highs' 'window ticks' 'window highs' 'window periods' 'ADC sample' 'ADC external' 'ADC scope' 'sync transmit' 'sync receive' 'async transmit' 'async receive'
