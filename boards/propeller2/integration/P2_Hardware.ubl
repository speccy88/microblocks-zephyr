}

spec 'b' 'p2ADCScope' 'P2 try ADC scope pin _ X hex _ Y hex _ B offset _' 'num str str num' 0 '0' '0' 0
to p2ADCScope pin x y b {
    return ('[p2:p2Configure]' pin 'ADC scope' 'ADC 1x' x y false b)
}

to p2SyncTransmit pin bits word b {
    if (or (bits < 1) (bits > 32)) { return false }
    return ('[p2:p2Configure]' pin 'sync transmit' 'logic' (32 + (bits - 1)) word true b)
}

to p2SyncReceive pin bits b {
    if (or (bits < 1) (bits > 32)) { return false }
    return ('[p2:p2Configure]' pin 'sync receive' 'Schmitt' (32 + (bits - 1)) 0 false b)
}

to p2AsyncTransmit pin baud {
    return ('[p2:p2UART]' pin baud true)
}

to p2AsyncReceive pin baud {
    return ('[p2:p2UART]' pin baud false)
}

to p2SawPWM pin hz duty {
    return ('[p2:p2PWM]' pin hz duty false)
}

to p2TrianglePWM pin hz duty {
    return ('[p2:p2PWM]' pin hz duty true)
}


to p2EventCode sensitivity {
    if (sensitivity == 'high') { return 0 }
    if (sensitivity == 'rise') { return 1 }
    if (sensitivity == 'edge') { return 2 }
    return -1
}
to p2EdgeCode sensitivity {
    if (sensitivity == 'rise to rise') { return 0 }
    if (sensitivity == 'rise to edge') { return 1 }
    if (sensitivity == 'edge to rise') { return 2 }
    if (sensitivity == 'edge to edge') { return 3 }
    return -1
}
to p2MeasureEvents count pin sensitivity {
    local 'trigger' (p2EventCode sensitivity)
    if (or (count < 1) (trigger < 0)) { return false }
    return ('[p2:p2Configure]' pin 'event ticks' 'Schmitt' count trigger false 0)
}
to p2Timeout pin clocks sensitivity {
    local 'trigger' (p2EventCode sensitivity)
    if (or (clocks < 1) (trigger < 0)) { return false }
    return ('[p2:p2Configure]' pin 'event ticks' 'Schmitt' clocks (4 + trigger) false 0)
}
to p2MeasurePeriods pin count result sensitivity b {
    local 'trigger' (p2EdgeCode sensitivity)
    if (or (count < 1) (trigger < 0)) { return false }
    if (result == 'clock ticks') {
        return ('[p2:p2Configure]' pin 'period ticks' 'Schmitt' count trigger false b)
    }
    if (result == 'high clocks') {
        return ('[p2:p2Configure]' pin 'period highs' 'Schmitt' count trigger false b)
    }
    return false
}
to p2MeasureWindow pin clocks result sensitivity b {
    local 'trigger' (p2EdgeCode sensitivity)
    if (or (clocks < 1) (trigger < 0)) { return false }
    if (result == 'clock ticks') {
        return ('[p2:p2Configure]' pin 'window ticks' 'Schmitt' clocks trigger false b)
    }
    if (result == 'high clocks') {
        return ('[p2:p2Configure]' pin 'window highs' 'Schmitt' clocks trigger false b)
    }
    if (result == 'periods') {
        return ('[p2:p2Configure]' pin 'window periods' 'Schmitt' clocks trigger false b)
    }
    return false
}
to p2DifferenceCounter pin b clocks highs {
    if (clocks < 0) { return false }
    if highs { return ('[p2:p2Configure]' pin 'count highs' 'Schmitt' clocks 1 false b) }
    return ('[p2:p2Configure]' pin 'count rises' 'Schmitt' clocks 1 false b)
}
to p2ADCSampleInput pin bits circuit {
    if (or (bits < 2) (bits > 14)) { return false }
    return ('[p2:p2ADCSetup]' pin 'sample' (bits - 1) false circuit 0)
}
to p2ADCExternalInput pin bits b {
    if (or (bits < 2) (bits > 14)) { return false }
    return ('[p2:p2ADCSetup]' pin 'sample' (bits - 1) true 'Schmitt' b)
}
to p2ADCCapture pin external b {
    if external { return ('[p2:p2ADCSetup]' pin 'bitstream' 5 true 'Schmitt' b) }
    return ('[p2:p2ADCSetup]' pin 'bitstream' 5 false 'ADC 1x' 0)
}
to p2ScopeInput pin filter a b circuit {
    local 'choice' -1
    if (filter == 'Tukey 68') { choice = 0 }
    if (filter == 'Tukey 45') { choice = 1 }
    if (filter == 'Hann 28') { choice = 2 }
    return ('[p2:p2Scope]' pin choice a b circuit)
}


to p2StartSINC pin kind clocks keep count cog {
    return ('[p2:p2CaptureStart]' pin kind clocks keep count cog false 0 1000)
}
to p2StartExternalSINC pin kind clocks keep count cog b {
    return ('[p2:p2CaptureStart]' pin kind clocks keep count cog true b 2000)
}
to p2StartBitCapture pin words cog external b {
    return ('[p2:p2CaptureStart]' pin 'bits' 32 1 words cog external b 5000)
}
to p2CaptureState {
    local 'state' ('[p2:p2CaptureInfo]' 'state')
    if (state == 0) { return 'idle' }
    if (state == 1) { return 'running' }
    if (state == 2) { return 'complete' }
    if (state == 3) { return 'canceled' }
    if (state == 4) { return 'buffer full' }
    if (state == 5) { return 'clock timeout' }
    if (state == 7) { return 'armed pretrigger' }
    return 'timing failure'
}


to p2StartScopeBurst base channels usecs count cog {
    if (or (usecs < 3) (usecs > 10000)) { return false }
    local 'ticks' (usecs * (('[p2:p2ClockHz]') / 1000000))
    return ('[p2:p2ScopeCapture]' base channels ticks count cog -1 1000)
}
to p2StartTriggeredScope base channels usecs count cog trigger {
    if (or (usecs < 3) (usecs > 10000)) { return false }
    local 'ticks' (usecs * (('[p2:p2ClockHz]') / 1000000))
    return ('[p2:p2ScopeCapture]' base channels ticks count cog trigger 1000)
}


to p2StartSINCWithCircuit pin kind clocks keep count cog circuit {
    return ('[p2:p2CaptureStart]' pin kind clocks keep count cog false 0 1000 circuit)
}

to p2AsyncTransmitWords pin baud bits inverted {
    return ('[p2:p2AsyncWords]' pin baud bits true inverted)
}
to p2AsyncReceiveWords pin baud bits inverted {
    return ('[p2:p2AsyncWords]' pin baud bits false inverted)
}

to p2FilteredInput pin bank {
    return ('[p2:p2FilterInput]' pin bank 0 false 0 false)
}
to p2FilteredRises pin bank clocks {
    if (clocks < 0) { return false }
    return ('[p2:p2ConfigureInputs]' pin 'count rises' 'Schmitt' clocks 0 false 0 0 bank)
}
to p2FilteredSmartPin pin operation circuit x y drive a b bank {
    return ('[p2:p2ConfigureInputs]' pin operation circuit x y drive a b bank)
}
to p2DebounceInput pin bank usecs {
    if (not ('[p2:p2PinUsable]' pin)) { return false }
    if (or (usecs < 1) (usecs > 1000000)) { return false }
    local 'target' (usecs * (('[p2:p2ClockHz]') / 1000000))
    local 'tap' 0
    local 'period' 1
    while ((7 * period) < target) {
        period = (period * 2)
        tap += 1
    }
    if (not ('[p2:p2FilterConfigure]' bank 8 tap)) { return false }
    return (p2FilteredInput pin bank)
}
to p2StartExternalBitStream pin cog b timeout {
    return ('[p2:p2CaptureStart]' pin 'bits' 32 1 0 cog true b timeout)
}


to p2SamplingPower maximum {
    local 'frequency' ('[p2:p2ClockHz]')
    if (or (maximum < 1) (maximum > frequency)) { return -1 }
    local 'power' 0
    local 'clocks' 1
    while ((((frequency + clocks) - 1) / clocks) > maximum) {
        power += 1
        if (power > 15) { return -1 }
        clocks = (clocks * 2)
    }
    return power
}
to p2StartInternalStream pin circuit maximum cog {
    local 'power' (p2SamplingPower maximum)
    if (power < 0) { return false }
    return ('[p2:p2DMACapture]' pin circuit power 0 cog)
}
to p2RecordInternalBits pin circuit power words cog {
    if (or (words < 128) (words > 768)) { return false }
    if ((words % 128) != 0) { return false }
    return ('[p2:p2DMACapture]' pin circuit power (words / 128) cog)
}
to p2CaptureRunning {
    local 'state' ('[p2:p2CaptureInfo]' 'state')
    return (or (state == 1) (state == 7))
}
to p2CaptureComplete { return (('[p2:p2CaptureInfo]' 'state') == 2) }
to p2CaptureHasData { return (('[p2:p2CaptureInfo]' 'available') > 0) }
to p2CaptureAvailable { return ('[p2:p2CaptureInfo]' 'available') }
to p2CaptureSampleRate {
    local 'clocks' ('[p2:p2CaptureInfo]' 'sample clocks')
    if (clocks < 1) { return false }
    return (('[p2:p2ClockHz]') / clocks)
}

to p2RecordRecentBits pin circuit maximum history after cog trigger high timeout {
    local 'power' (p2SamplingPower maximum)
    if (or (power < 0) (history < 128) (history > 384) (after < 128) (after > 384)) { return false }
    if (or ((history % 128) != 0) ((after % 128) != 0)) { return false }
    return ('[p2:p2DMARecord]' pin circuit power (history / 128) (after / 128) cog trigger high timeout)
}


to p2PWMPercent pin hz percent {
    if (or (percent < 0) (percent > 100)) { return false }
    return ('[p2:p2PWM]' pin hz (percent * 10) false)
}
to p2ServoPulseUS pin usecs {
    if (not ('[p2:p2PinUsable]' pin)) { return false }
    if (or (usecs < 500) (usecs > 2500)) { return false }
    return ('[p2:setServo]' pin usecs)
}
to p2ServoAngle pin angle low high {
    if (or (angle < 0) (angle > 180) (low < 500) (high > 2500) (low >= high)) { return false }
    return (p2ServoPulseUS pin (low + ((angle * (high - low)) / 180)))
}
to p2TimedSquare pin hz msecs {
    if (not ('[p2:p2PinUsable]' pin)) { return false }
    if (or (hz < 16) (hz > 20000) (msecs < 1) (msecs > 10000)) { return false }
    if (not ('[p2:p2Frequency]' pin hz)) { return false }
    waitMillis msecs
    return ('[p2:p2PinRelease]' pin)
}
to p2WaitPinReady pin timeout {
    if (not ('[p2:p2PinUsable]' pin)) { return false }
    if (or (timeout < 1) (timeout > 10000)) { return false }
    local 'started' (millisOp)
    while (not ('[p2:p2PinReady]' pin)) {
        if ((millisSince started) >= timeout) { return false }
        waitMillis 1
    }
    return true
}
to p2ReadReady pin timeout {
    if (not (p2WaitPinReady pin timeout)) { return false }
    return ('[p2:p2PinRead]' pin)
}
to p2TicksToUS ticks {
    if (ticks < 0) { return false }
    local 'scale' (('[p2:p2ClockHz]') / 1000000)
    if (scale < 1) { return false }
    return (ticks / scale)
}
to p2MeasurePulseTicks pin result timeout {
    if (or (timeout < 1) (timeout > 10000)) { return false }
    local 'started' (millisOp)
    local 'ok' false
    if (result == 'high') { ok = (p2HighTicks pin) }
    if (result == 'period') { ok = (p2MeasurePeriods pin 1 'clock ticks' 'rise to rise' 0) }
    if (not ok) { return false }
    local 'remaining' (timeout - (millisSince started))
    if (remaining < 1) { return false }
    if (not (p2WaitPinReady pin remaining)) { return false }
    '[p2:p2PinRead]' pin
    remaining = (timeout - (millisSince started))
    if (remaining < 1) { return false }
    return (p2ReadReady pin remaining)
}
to p2MeasureHighUS pin timeout {
    local 'ticks' (p2MeasurePulseTicks pin 'high' timeout)
    if (ticks == false) { return false }
    return (p2TicksToUS ticks)
}
to p2MeasurePeriodUS pin timeout {
    local 'ticks' (p2MeasurePulseTicks pin 'period' timeout)
    if (ticks == false) { return false }
    return (p2TicksToUS ticks)
}
to p2MeasureFrequency pin timeout {
    local 'ticks' (p2MeasurePulseTicks pin 'period' timeout)
    if (ticks == false) { return false }
    if (ticks < 1) { return false }
    return (('[p2:p2ClockHz]') / ticks)
}
to p2MeasureDutyPermille pin timeout {
    if (or (timeout < 1) (timeout > 10000)) { return false }
    local 'started' (millisOp)
    local 'high' (p2MeasurePulseTicks pin 'high' timeout)
    if (high == false) { return false }
    local 'remaining' (timeout - (millisSince started))
    if (remaining < 1) { return false }
    local 'period' (p2MeasurePulseTicks pin 'period' remaining)
    if (period == false) { return false }
    if (or (period < 1) (high < 0) (high > period)) { return false }
    return ('[p2:p2ScaleSample]' high 0 period 1000)
}
to p2MeasureDutyPercent pin timeout {
    local 'duty' (p2MeasureDutyPermille pin timeout)
    if (duty == false) { return false }
    return ((duty + 5) / 10)
}
to p2CountWindowMS pin msecs timeout {
    if (or (msecs < 1) (msecs > 5000) (timeout < msecs) (timeout > 10000)) { return false }
    local 'clocks' (msecs * (('[p2:p2ClockHz]') / 1000))
    if (not (p2CountRises pin clocks)) { return false }
    return (p2ReadReady pin timeout)
}
